cask "discky" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/AlxGolubev/discky/releases/download/v#{version}/Discky-#{version}.zip"
  name "Discky"
  desc "Disk cleanup for macOS that only uses official removal mechanisms, with an MCP server"
  homepage "https://github.com/AlxGolubev/discky"

  depends_on arch: :arm64
  depends_on macos: ">= :sequoia"

  app "Discky.app"
  binary "#{appdir}/Discky.app/Contents/MacOS/discky-mcp"

  postflight do
    # Discky is not notarized (no paid Apple developer account). Strip the quarantine
    # attribute so Gatekeeper lets it open; the tap's caveats say so.
    system_command "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "#{appdir}/Discky.app"], sudo: false
  end

  zap trash: [
    "~/Library/Application Support/Discky",
    "~/Library/Saved Application State/com.alxgol.discky.savedState",
  ]

  caveats <<~EOS
    Discky is not notarized (no paid Apple developer account), so this cask removes
    the macOS quarantine attribute from Discky.app after installing it. If you would
    rather not, uninstall it and build from source instead (see the README).
    Grant Full Disk Access on first launch so the scan can see all of ~/Library.
    Connect the MCP server to Claude Code with:
      claude mcp add discky -- #{HOMEBREW_PREFIX}/bin/discky-mcp
  EOS
end
